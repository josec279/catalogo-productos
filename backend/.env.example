# Copia este archivo como .env y reemplaza los valores.
# Usa la cadena del "Session pooler" de Supabase (Connect -> Session pooler).
DATABASE_URL=postgresql+psycopg2://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres

# Opcional: Incoming Webhook de Slack para avisar cuando se crea un producto
SLACK_WEBHOOK_URL=
